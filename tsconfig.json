{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "target": "ES2022",

    "module": "CommonJS",
    "moduleResolution": "Node",

    "esModuleInterop": true,

    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
